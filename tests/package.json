{
  "name": "chatgpt-beast-mode-tests",
  "version": "1.0.0",
  "description": "Automated playtests for SmryX extension",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:ask-question": "playwright test tests/playtest-ask-question.spec.ts",
    "test:batch": "playwright test tests/playtest-ask-question.spec.ts -g \"Batch\"",
    "test:providers": "playwright test tests/playtest-ask-question.spec.ts -g \"Provider\"",
    "install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "playwright": "^1.40.0"
  }
}