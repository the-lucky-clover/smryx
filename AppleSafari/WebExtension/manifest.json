{
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "1.9.9",
  "manifest_version": 3,
  "icons": {
    "16": "logo-16.png",
    "32": "logo-32.png",
    "48": "logo-48.png",
    "128": "logo-128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "unlimitedStorage",
    "alarms",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "scripts": [
      "safari/background-compat.js",
      "shared/remove-legacy-analytics.js",
      "shared/analytics-config.js",
      "shared/analytics-schema.js",
      "background/analytics.js",
      "background/full-text.js",
      "background/index.js",
      "safari/share-background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_icon": {
      "16": "logo-16.png",
      "32": "logo-32.png",
      "48": "logo-48.png",
      "128": "logo-128.png"
    },
    "default_title": "__MSG_appActionTitle__",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script/index.js",
        "safari/share-content.js",
        "safari/mobile-viewport.js"
      ],
      "run_at": "document_start",
      "css": [
        "styles.css",
        "safari/content-mobile.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/index.html",
        "./pdf.worker.js",
        "./wasm/sha3_wasm_bg.wasm"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "short_name": "Sumyst"
}
