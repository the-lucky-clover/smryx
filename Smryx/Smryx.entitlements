<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Groups: the extension and the app share defaults + library files. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.luckyclover.smryx</string>
	</array>
	<!-- Keychain Sharing: one access group so the app can save the API key
	     and the extension's native handler can read it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.luckyclover.smryx</string>
	</array>
	<!-- Sandboxed app that calls the user's AI endpoint. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
